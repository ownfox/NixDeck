# ╔══════════════════════════════════════════════════════════════════╗
# ║  Модуль: Steam Input — радиальные меню и слои управления        ║
# ║  Навигация через тачпады Steam Deck без физической клавиатуры   ║
# ╚══════════════════════════════════════════════════════════════════╝
{ config, pkgs, ... }:

{
  # Steam Input настраивается через Desktop Configuration в клиенте Steam.
  # Этот модуль обеспечивает необходимые системные зависимости.

  # ── Пакеты для интеграции ──────────────────────────────────────
  environment.systemPackages = with pkgs; [
    # Для корректной работы Steam Input в Wayland-сессии
    xdotool          # симуляция ввода (fallback для X11 игр)
    wtype            # симуляция ввода для Wayland
    ydotool          # ввод на системном уровне (root)
  ];

  # ── uinput для ydotool (системный ввод) ────────────────────────
  programs.ydotool.enable = true;

  # ╔══════════════════════════════════════════════════════════════╗
  # ║  НАСТРОЙКА STEAM INPUT (инструкция)                          ║
  # ║                                                              ║
  # ║  1. Откройте Steam → Settings → Controller                  ║
  # ║  2. Desktop Configuration → выберите шаблон                  ║
  # ║  3. Настройте радиальные меню на трекпадах:                  ║
  # ║     - Левый трекпад: модификаторы (Super, Alt, Ctrl, Shift) ║
  # ║     - Правый трекпад: действия (окна, рабочие столы)        ║
  # ║  4. D-Pad → rofi лаунчер                                    ║
  # ║  5. Задние лепестки (L4, L5, R4, R5):                       ║
  # ║     - L4: Super (модификатор)                                ║
  # ║     - L5: Alt                                                ║
  # ║     - R4: wvkbd (виртуальная клавиатура)                    ║
  # ║     - R5: fullscreen toggle                                 ║
  # ╚══════════════════════════════════════════════════════════════╝
}
